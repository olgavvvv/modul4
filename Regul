using System.Text.RegularExpressions;

string FIO = "Иванов1 Иван Иванович";

if (Regex.IsMatch(FIO, @"^[а-яА-ЯЁ-ё\s]+$"))
{
    Console.WriteLine("Валидно");
}
else
{
    Console.WriteLine("Не валидно");
}


